rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aliahmedmunkaila@gmail.com'
      );
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserRole() == 'admin'
      );
    }

    function isStaff() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserRole() == 'staff'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow list: if isStaff();
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && (request.resource.data.role == 'member' || isBootstrappedAdmin())) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Member Profiles
    match /memberProfiles/{profileId} {
      allow get: if isSignedIn() && (
        isStaff() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          resource.data.phoneNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
        )
      );
      allow list: if isStaff();
      allow create: if isStaff() || isSignedIn();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Customer Enquiries
    match /enquiries/{enquiryId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      allow create: if true; // Public or logged-in users can send enquiries
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Payment Records
    match /paymentRecords/{paymentId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Matchmaking Suggestions
    match /matchmakingSuggestions/{suggestionId} {
      allow read, write: if isStaff();
    }

    // App Settings
    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit logs
    }
  }
}
